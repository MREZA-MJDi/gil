APP_NAME="سامانه مدیریت رستوران"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran

# Set before creating products/orders. Allowed values: تومان or ریال.
RESTAURANT_CURRENCY_LABEL=تومان

# One shared administrator account for the manager and authorized reviewers.
# Sign-in username is ADMIN_PHONE (Iranian mobile); password is ADMIN_PASSWORD.
# ADMIN_EMAIL is optional account metadata and is not used as the login username.
# Sync/create this account with: php artisan db:seed --class=AdminUserSeeder --force
RESTAURANT_NAME="نام مجموعه"
ADMIN_NAME="مدیر سامانه"
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local-only sample catalog, recipes, orders, reservations and cash-flow data.
# Never enable this on a database containing real restaurant records.
SEED_RESTAURANT_DEMO=false

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# File sessions avoid a database sessions-table dependency and work on the HTTP test URL.
# Ensure the PHP-FPM / web-server user can write to storage/framework/sessions.
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
